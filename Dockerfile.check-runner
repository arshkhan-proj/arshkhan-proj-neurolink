FROM node:24-alpine

ENV HOME=/tmp
ENV XDG_CACHE_HOME=/tmp/.cache
ENV COREPACK_HOME=/tmp/.corepack
ENV PNPM_HOME=/tmp/.local/share/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"

WORKDIR /usr/src/app

# Enable pnpm so snapshot commands like `pnpm test` work.
RUN corepack enable && corepack prepare pnpm@10.15.0 --activate

# GCS SDK for snapshot pulls + set ESM mode.
RUN npm install @google-cloud/storage && npm pkg set type=module

COPY check-runner.js snapshotStorage.js pullSnapshot.js ./

# Non-root user.
RUN addgroup -g 1001 runner && adduser -u 1001 -G runner -D runner && \
    chown -R runner:runner /usr/src/app /tmp

EXPOSE 4000
USER runner
CMD ["node", "check-runner.js"]
