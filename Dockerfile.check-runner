FROM node:20-bullseye

# 1. Workdir
WORKDIR /app

# 2. Enable pnpm via corepack
RUN corepack enable

# 3. Copy package metadata first (for caching)
COPY package.json pnpm-lock.yaml ./

# 4. Install deps
RUN pnpm install --frozen-lockfile

# 5. Runtime dep for snapshot pulls (used by pullSnapshot.js)
RUN npm install --no-save @google-cloud/storage@^7.19.0

# 6. Copy full source
COPY . .

# 7. Build CLI only
RUN NODE_OPTIONS="--max_old_space_size=2048" pnpm run build:cli

# 8. Ensure script is executable
RUN chmod +x /app/run-sandbox-checks.sh

# 9. Expose port
EXPOSE 4000

# 10. Default env
ENV CHECK_RUNNER_SECRET=change-me
ENV PORT=4000

# 11. Start HTTP check runner
CMD ["node", "check-runner.js"]

