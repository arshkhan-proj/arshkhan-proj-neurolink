FROM node:20-bullseye-slim

WORKDIR /app

# git is needed for `git apply` in editOperations.js (removed after each use).
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Only the two runtime dependencies — no full project install.
RUN npm init -y && \
    npm install --save-exact @aws-sdk/client-s3@3.886.0 @google-cloud/storage@7.19.0

# Copy only the files the check-runner actually uses.
COPY check-runner.js \
     snapshotStorage.js \
     pullSnapshot.js \
     pushSnapshot.js \
     editOperations.js \
     ./

# Create a non-root user for running commands.
# The server itself and all commands run as this user.
RUN groupadd --gid 1001 runner && \
    useradd --uid 1001 --gid 1001 --create-home runner && \
    chown -R runner:runner /app /tmp

EXPOSE 4000

ENV CHECK_RUNNER_SECRET=change-me
ENV PORT=4000

USER runner

CMD ["node", "check-runner.js"]
